// use prisma-next

enum UserRole {
  @@type("pg/text@1")
  CUSTOMER     = "CUSTOMER"
  PROFESSIONAL = "PROFESSIONAL"
}

enum BookingStatus {
  @@type("pg/text@1")
  COMPLETED = "COMPLETED"
  CONFIRMED = "CONFIRMED"
  HELD      = "HELD"
  CANCELLED = "CANCELLED"
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  role      UserRole  @default(CUSTOMER)
  username  String?
  name      String?
  phone     String?
  address   String?

  bookings      Booking[]
  professionals Professional[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Professional {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String?
  user      User?     @relation(fields: [userId], references: [id])
  userId    Int?
  bookings  Booking[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Booking {
  id             Int           @id @default(autoincrement())
  service        String
  bookingDate    TimestamptzString
  status         BookingStatus

  customer       User          @relation(fields: [customerId], references: [id])
  customerId     Int

  professional   Professional  @relation(fields: [professionalId], references: [id])
  professionalId Int

  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}
